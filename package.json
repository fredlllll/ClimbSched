{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "build:app": "esbuild resources/ts/app.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=public/assets/app.js",
        "dev:app": "esbuild resources/ts/app.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=public/assets/app.js --watch"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7",
        "esbuild": "^0.25.9"
    }
}
